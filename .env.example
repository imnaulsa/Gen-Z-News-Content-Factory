# Netlify build environment: ONLY these public values go into the browser.
PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY

# Worker lokal ONLY. Jangan commit .env atau menaruh secret di Netlify/browser.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
WORKER_OWNER_ID=YOUR_SUPABASE_USER_UUID

# Default free-first untuk trial.
TEXT_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
TTS_PROVIDER=edge
EDGE_TTS_VOICE=id-ID-ArdiNeural
EDGE_TTS_RATE=+0%
EDGE_TTS_VOLUME=+0%
EDGE_TTS_PITCH=+0Hz

# Opsional nanti bila ingin berpindah ke ElevenLabs berbayar.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Opsional nanti bila ingin berpindah ke OpenAI.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts

MAX_VIDEOS_PER_DAY=3
POLL_SECONDS=10
